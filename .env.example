AUTH_API_URL=
APP_ENV=
# Gere um segredo aleatório de pelo menos 32 caracteres. Nunca publique o valor.
SESSION_SECRET=

# Autenticação independente: login Supabase e ingresso inicial GestPV.
# No desenvolvimento, os links voltam ao Next local. Em produção, usar:
# https://ministerio-contabil.ibpalavraviva.com.br
APP_URL=
# Project URL do Supabase, sem /auth/v1 ou caminhos adicionais.
SUPABASE_URL=
# Chaves modernas do painel Supabase; somente no servidor, sem NEXT_PUBLIC_.
SUPABASE_PUBLISHABLE_KEY=
# Reservada às operações administrativas de habilitação/convite.
SUPABASE_SECRET_KEY=
# Resend SMTP fica configurado no Supabase; não copiar a chave Resend para cá.
