{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Local: Next.js e navegador",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Ready in",
        "uriFormat": "http://localhost:5174",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Local: navegador (servidor já iniciado)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Local: anexar ao servidor Next.js",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9230,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Local: anexar ao Worker / Miniflare",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    }
  ]
}
