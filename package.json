{
  "name": "cantina-contabil",
  "version": "0.6.3",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts docs tests *.json *.ts *.md *.mts",
    "format:check": "prettier --check src scripts docs tests *.json *.ts *.md *.mts",
    "dev:debug": "node scripts/dev.mjs --debug",
    "dev:worker": "node scripts/dev-worker.mjs",
    "db:local": "node scripts/local-db.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@fontsource/manrope": "5.3.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "miniflare": "5.20261019.2-beta",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
